# Copie este arquivo para .env.local e preencha com os valores do SEU projeto Firebase.
# Onde encontrar: Console do Firebase → ⚙ Configurações do projeto → Geral → "Seus apps" → app Web → Configuração do SDK.
# Esses valores identificam o projeto e não são segredos: a proteção dos dados está nas regras do Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional (recomendado em produção): chave do site reCAPTCHA Enterprise usada pelo Firebase App Check.
# Deixe em branco para desativar o App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Opcional: endereço público do site (usado nas tags de compartilhamento). Ex.: https://muquifo.web.app
VITE_SITE_URL=

# Desenvolvimento: "true" conecta aos emuladores locais do Firebase (Auth 9099, Firestore 8080).
VITE_USE_FIREBASE_EMULATORS=false
